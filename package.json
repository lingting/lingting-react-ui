{
  "name": "lingting-react-ui",
  "version": "0.1.0",
  "description": "基于 React 与 Ant Design 的专用高级组件库",
  "sideEffects": ["**/*.css"],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/lingting-react-ui.umd.cjs",
  "module": "./dist/lingting-react-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lingting-react-ui.js",
      "require": "./dist/lingting-react-ui.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc -p tsconfig.build.json",
    "format": "vp fmt"
  },
  "devDependencies": {
    "@ant-design/cli": "~6.5.3",
    "@tailwindcss/vite": "~4.1.18",
    "@types/node": "~22.13.1",
    "@types/react": "~19.2.8",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~5.1.1",
    "tailwindcss": "~4.1.18",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ant-design/icons": "~6.3.2",
    "@ant-design/pro-components": "^3.1.14-6",
    "@tanstack/react-query": "~5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-store": "^0.11.0",
    "antd": "~6.5.1",
    "clsx": "~2.1.1",
    "dayjs": "~1.11.21",
    "react": "~19.2.7",
    "react-dom": "~19.2.7"
  },
  "volta": {
    "node": "22.22.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
