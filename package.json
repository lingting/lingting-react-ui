{
  "name": "lingting-react-ui",
  "version": "2026.9.264",
  "description": "基于 React 与 Ant Design 的专用高级组件库",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lingting/lingting-react-ui.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./index.css": "./dist/index.css",
    "./blocks": {
      "types": "./dist/types/blocks/index.d.ts",
      "import": "./dist/blocks.js"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./components/cloudflare": {
      "types": "./dist/types/components/cloudflare/index.d.ts",
      "import": "./dist/components/cloudflare.js"
    },
    "./components/copy": {
      "types": "./dist/types/components/copy/index.d.ts",
      "import": "./dist/components/copy.js"
    },
    "./components/dict": {
      "types": "./dist/types/components/dict/index.d.ts",
      "import": "./dist/components/dict.js"
    },
    "./components/ex-button": {
      "types": "./dist/types/components/ex-button/index.d.ts",
      "import": "./dist/components/ex-button.js"
    },
    "./components/ex-card": {
      "types": "./dist/types/components/ex-card/index.d.ts",
      "import": "./dist/components/ex-card.js"
    },
    "./components/ex-form": {
      "types": "./dist/types/components/ex-form/index.d.ts",
      "import": "./dist/components/ex-form.js"
    },
    "./components/ex-list": {
      "types": "./dist/types/components/ex-list/index.d.ts",
      "import": "./dist/components/ex-list.js"
    },
    "./components/ex-table": {
      "types": "./dist/types/components/ex-table/index.d.ts",
      "import": "./dist/components/ex-table.js"
    },
    "./components/region": {
      "types": "./dist/types/components/region/index.d.ts",
      "import": "./dist/components/region.js"
    },
    "./desktop": {
      "types": "./dist/types/desktop/index.d.ts",
      "import": "./dist/desktop.js"
    },
    "./hooks": {
      "types": "./dist/types/hooks/index.d.ts",
      "import": "./dist/hooks.js"
    },
    "./layout": {
      "types": "./dist/types/layout/index.d.ts",
      "import": "./dist/layout.js"
    },
    "./layout/sidebar-common": {
      "types": "./dist/types/layout/sidebar-common/index.d.ts",
      "import": "./dist/layout/sidebar-common.js"
    },
    "./lib": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/lib.js"
    },
    "./store": {
      "types": "./dist/types/store/index.d.ts",
      "import": "./dist/store.js"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "import": "./dist/types.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "vp fmt && vp check --fix"
  },
  "devDependencies": {
    "@ant-design/cli": "~6.6.0",
    "@tailwindcss/vite": "~4.1.18",
    "@types/node": "~22.13.1",
    "@types/react": "~19.2.8",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~5.1.1",
    "tailwindcss": "~4.1.18",
    "tsc-alias": "~1.9.5",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "~6.3.2",
    "@ant-design/plots": "~2.6.8",
    "@ant-design/pro-components": "^3.1.14-6",
    "@ant-design/x": "~2.8.0",
    "@ant-design/x-markdown": "~2.8.0",
    "@ant-design/x-sdk": "~2.8.0",
    "@marsidev/react-turnstile": "~1.6.1",
    "@tanstack/react-query": "~5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-store": "^0.11.0",
    "antd": "~6.6.0",
    "clsx": "~2.1.1",
    "dayjs": "~1.11.21",
    "react": "~19.2.7",
    "react-dom": "~19.2.7"
  },
  "volta": {
    "node": "22.22.3"
  }
